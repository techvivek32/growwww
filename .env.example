# ---------------------------------------------------------------------------
# NOVA India — Phase 1 needs none of this. Everything below is Phase 2 (live).
# Copy to .env.local and fill in. NEVER commit the real file.
# ---------------------------------------------------------------------------

# Order gateway running on the VPS whose IP is whitelisted with Groww.
# Empty = paper mode (the default).
NEXT_PUBLIC_BROKER_API_URL=

# ---- Server-side only. These live on the VPS gateway, not on Vercel. ----

# From groww.in/trade-api/api-keys — use the TOTP flow, not the direct
# Access Token flow, or a human has to re-approve every single morning.
GROWW_API_KEY=
GROWW_API_SECRET=

# The base32 TOTP seed shown once beside the QR code. The server needs this
# string, not a phone scan — it mints its own access token each morning.
GROWW_TOTP_SECRET=

# The exact egress IP registered with Groww, verified on the VPS with:
#   curl -4 -s https://api.ipify.org
# Outbound order requests are pinned to it, so a mismatch fails loudly
# instead of leaking out of the wrong address.
GROWW_REGISTERED_IP=

# Supabase project for the trade archive (groww_trades). Separate project
# from any other deployment.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
