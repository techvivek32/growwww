# ---------------------------------------------------------------------------
# MNHA Financials — copy to .env.local and fill in. NEVER commit the real file.
# ---------------------------------------------------------------------------

# ---- Site -----------------------------------------------------------------
# Canonical origin, used for metadataBase and Open Graph URLs.
# Defaults to https://visionmarket.in when unset.
NEXT_PUBLIC_SITE_URL=

# ---- Sign-in ---------------------------------------------------------------
# The app ships with working fallbacks so a fresh clone runs, but those
# fallbacks are readable by anyone who can read this repository. Set these
# three in the deployment environment (Vercel > Settings > Environment
# Variables) and the fallbacks stop being used.
AUTH_EMAIL=
AUTH_PASSWORD=
# Signs the session cookie. Any long random string; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=


# Order gateway running on the host whose IP is registered with Groww.
# Empty (the default) means no broker is connected: every account screen shows
# its empty state instead of a number nobody can stand behind. Market data
# does not depend on this — prices come from Yahoo either way.
BROKER_API_URL=

# Display name for the signed-in account. Defaults to Rahul Shah.
ACCOUNT_NAME=

# ---- Server-side only. These live on the VPS gateway, not on Vercel. ----

# From groww.in/trade-api/api-keys — use the TOTP flow, not the direct
# Access Token flow, or a human has to re-approve every single morning.
GROWW_API_KEY=
GROWW_API_SECRET=

# The base32 TOTP seed shown once beside the QR code. The server needs this
# string, not a phone scan — it mints its own access token each morning.
GROWW_TOTP_SECRET=

# The exact egress IP registered with Groww, verified on the VPS with:
#   curl -4 -s https://api.ipify.org
# Outbound order requests are pinned to it, so a mismatch fails loudly
# instead of leaking out of the wrong address.
GROWW_REGISTERED_IP=

# Supabase project for the trade archive (groww_trades). Separate project
# from any other deployment.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
