# Example nginx site for the MNHA Financials web app. It is a reference to compare with
# the live config on the server, not a drop-in: certificates and server names are yours.
# The lines marked REQUIRED are what the app's security relies on (src/lib/clientIp.ts).
#
# The app runs as `npm start`, which is `next start -H 127.0.0.1` on port 3000: it is
# reachable ONLY through this proxy on the same machine, never directly from outside.

server {
    listen 80;
    listen [::]:80;
    server_name mnhafinancials.com www.mnhafinancials.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # http2 on;   # nginx 1.25.1 and later
    server_name mnhafinancials.com www.mnhafinancials.com;

    # ssl_certificate     /etc/letsencrypt/live/mnhafinancials.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mnhafinancials.com/privkey.pem;

    # Identity photos and KYC files go up to 10 MB; the app's own body limit is 11 MB.
    client_max_body_size 11m;

    location / {
        # REQUIRED: the IPv4 loopback address the app listens on. Not "localhost" (it can
        # resolve to ::1, where nothing listens) and not the server's public IP.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # REQUIRED: overwrite, never pass on, what the client sent. The app trusts X-Real-IP
        # (and the LAST X-Forwarded-For entry) for the sign-in rate limits and for the IP
        # recorded with a signed agreement.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live prices stream as Server-Sent Events: no buffering, and long-lived reads.
    location /api/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
