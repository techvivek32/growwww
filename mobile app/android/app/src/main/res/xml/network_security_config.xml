<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere, with a narrow exception for local development.

  The base config forbids cleartext, so mnhafinancials.com — and any other
  real host — is HTTPS-only in debug and release alike. The exception is
  limited to the three addresses that can only ever mean "this machine":

    10.0.2.2   the Android emulator's alias for the host's localhost
    127.0.0.1  the device itself
    localhost  the same

  Listing them individually rather than setting usesCleartextTraffic="true"
  matters: that flag would open cleartext to every host, which turns a
  convenience for `next dev` into a downgrade path on a live trading session.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
