<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares INTERNET only in the debug and profile
         manifests. Without this line a RELEASE build has no network at all:
         every API call fails, and it presents as a server problem rather than
         a missing permission. The app is a thin client over mnhafinancials.com
         and does nothing offline, so this is not optional. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13 (API 33) and up refuse to show a notification until the
         user grants this at runtime, and the system only ever asks ONCE per
         install. The app therefore checks with the server that push is even
         configured before prompting — being denied here is close to permanent,
         so the prompt is not spent on an app that has nothing to deliver. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Transport rules live in network_security_config.xml: HTTPS for every
         real host, cleartext only for the emulator/loopback addresses used by
         the local build. A blanket usesCleartextTraffic="true" would have
         opened cleartext to every host, which is a downgrade path on a live
         trading session rather than a dev convenience. -->
    <application
        android:label="MNHA Financials"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Tapping a notification that the SYSTEM drew (app backgrounded
                 or dead) is delivered as this action, not as a plain launch.
                 Without a filter for it the intent resolves to nothing: the
                 notification arrives, looks right, and does nothing at all
                 when tapped, with "result code=-91" in the system log as the
                 only trace. The LAUNCHER filter above does not cover it. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- The channel a pushed notification lands in when the app is in the
             background or dead. It must match CHANNEL_ID in the server's
             push/fcm.ts and the channel the Dart side creates — Android 8+
             silently drops a notification whose channel does not exist, which
             presents as "push just doesn't work" with nothing in any log. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mnha_alerts" />
        <!-- A white-on-transparent silhouette. Without this Android falls back
             to the launcher icon and renders it as a flat grey square, because
             the status bar only keeps the alpha channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/mnha_notification" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
