[Unit]
Description=MNHA scalping research: fast scalp book: tick-level buy-sell-buy-sell on the LTP feed (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research scalp-fast
StandardOutput=append:/opt/mnha-research/data/scalp.log
StandardError=append:/opt/mnha-research/data/scalp.log
TimeoutStartSec=1h
