[Unit]
Description=MNHA scalping research: NSE-context scalp book: top gainers/losers and 52-week data, selective rules (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research scalp-nse
StandardOutput=append:/opt/mnha-research/data/scalp.log
StandardError=append:/opt/mnha-research/data/scalp.log
TimeoutStartSec=1h
