[Unit]
Description=MNHA live paper trading: mark the open paper position at live prices (no orders)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research livex-mark
StandardOutput=append:/opt/mnha-research/data/livex.log
StandardError=append:/opt/mnha-research/data/livex.log
TimeoutStartSec=3min
