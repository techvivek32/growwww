[Unit]
Description=MNHA active paper book: all-day scan and rotate (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research active
StandardOutput=append:/opt/mnha-research/data/active.log
StandardError=append:/opt/mnha-research/data/active.log
TimeoutStartSec=8h
