[Unit]
Description=MNHA live paper trading: 09:20 paper decision from the first 5-minute bar (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research live-decide
StandardOutput=append:/opt/mnha-research/data/live.log
StandardError=append:/opt/mnha-research/data/live.log
TimeoutStartSec=40min
