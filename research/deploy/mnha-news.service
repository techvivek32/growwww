[Unit]
Description=MNHA morning news list: Business Today company news before the open, per stock (no trades)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research news-check
StandardOutput=append:/opt/mnha-research/data/news.out
StandardError=append:/opt/mnha-research/data/news.out
TimeoutStartSec=20min
