[Unit]
Description=MNHA paper-trading session loop: decide, 5-second stop checks, flip, settle (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research livex-session
StandardOutput=append:/opt/mnha-research/data/livex.log
StandardError=append:/opt/mnha-research/data/livex.log
TimeoutStartSec=7h
