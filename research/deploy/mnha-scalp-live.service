[Unit]
Description=MNHA scalping research: live scalp book 11:00-11:15, ₹1,000 trail (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mnha-research.env
WorkingDirectory=/opt/mnha-research
ExecStart=/opt/mnha-research/.venv/bin/python -m mnha_research scalp-live
StandardOutput=append:/opt/mnha-research/data/scalp.log
StandardError=append:/opt/mnha-research/data/scalp.log
TimeoutStartSec=1h
